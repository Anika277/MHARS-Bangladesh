@page
@model MHARS.Web.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-12 col-md-7 col-lg-6">
        <div class="disaster-panel" data-reveal>
            <div class="disaster-panel-header">
                <span><i class="bi bi-person-plus-fill me-1"></i> Create Account</span>
            </div>
            <p class="small text-secondary mb-4">
                Register to join the <strong>RapidShonket</strong> response network. Accounts manage alerts and shelters.
                The <strong>Admin portal</strong> stays restricted to approved Administrator roles.
            </p>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label"></label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="you@example.gov.bd" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label"></label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="At least 6 characters" />
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Re-enter your password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn-brand-action w-100 justify-content-center py-2">
                    <i class="bi bi-box-arrow-in-right"></i> Register
                </button>
            </form>
            <div class="small text-center mt-4">
                Already have an account?
                <a asp-area="Identity" asp-page="/Account/Login" class="fw-semibold text-decoration-none">Login here</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}