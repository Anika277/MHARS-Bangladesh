@page
@model MHARS.Web.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-12 col-md-7 col-lg-6">
        <div class="disaster-panel" data-reveal>
            <div class="disaster-panel-header">
                <span><i class="bi bi-box-arrow-in-right me-1"></i> Sign In</span>
            </div>
            @if (TempData["StatusMessage"] is string status)
            {
                <div class="auth-status-banner" role="status">
                    <i class="bi bi-check-circle-fill"></i><span>@status</span>
                </div>
            }
            <p class="small text-secondary mb-4">
                Authorized personnel only. <strong>RapidShonket</strong> administrators access the alert and shelter
                management console from here.
            </p>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label"></label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="you@example.gov.bd" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label"></label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Your password" />
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="form-check form-check-inline mb-4">
                    <input asp-for="Input.RememberMe" class="form-check-input" />
                    <label asp-for="Input.RememberMe" class="form-check-label small"></label>
                </div>

                <button type="submit" class="btn-brand-action w-100 justify-content-center py-2">
                    <i class="bi bi-shield-lock-fill"></i> Login
                </button>
            </form>
            <div class="small text-center mt-4">
                Don't have an account?
                <a asp-area="Identity" asp-page="/Account/Register" class="fw-semibold text-decoration-none">Register here</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}