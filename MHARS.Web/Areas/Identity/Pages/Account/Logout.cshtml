@page
@model MHARS.Web.Areas.Identity.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Logout";
}

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-12 col-md-7 col-lg-6">
        <div class="disaster-panel text-center" data-reveal>
            <div class="disaster-panel-header justify-content-center">
                <span><i class="bi bi-box-arrow-left me-1"></i> Logout</span>
            </div>
            <p class="text-secondary mb-1">You have successfully logged out.</p>
            <p class="small text-secondary mb-4">Thank you for using RapidShonket.</p>
            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn-brand-action">
                <i class="bi bi-globe-americas"></i> Back to Live Radar
            </a>
        </div>
    </div>
</div>