@{
    // Used for nav highlighting. RouteData keys are lowercase in ASP.NET Core.
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string NavActive(string controller) => currentController == controller ? " active" : "";
}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RapidShonket</title>
    <meta name="description" content="RapidShonket — Bangladesh multi-hazard alert and response system. Check flood and earthquake alerts for your district." />

    <!--
        Theme is applied here, before anything paints. Running this at the end of
        <body> (as it was) meant a saved dark theme rendered the whole page white
        for one frame and then flipped — a visible flash on every navigation.
        Only the attribute is set here; the pill icon and label are updated later,
        once those elements actually exist.
    -->
    <script>
        (function () {
            try {
                if (localStorage.getItem('rs-theme') === 'dark') {
                    document.documentElement.setAttribute('data-theme', 'dark');
                }
            } catch (e) { /* private browsing blocks localStorage; light theme is fine */ }
        })();
    </script>

    <!-- Google Fonts: Plus Jakarta Sans (wordmark) + Hind Siliguri (brand) + Roboto Condensed (headings/nav) + Inter (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=Hind+Siliguri:wght@400;600;700&family=Roboto+Condensed:wght@400;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
    <!-- MHARS AI Assistant -->
<button id="mhars-agent-button"
        class="btn btn-primary shadow"
        style="position:fixed;right:20px;bottom:20px;z-index:2000;border-radius:50px;">
    💬 MHARS AI
</button>

<div id="mhars-agent-panel"
     style="display:none;position:fixed;right:20px;bottom:80px;width:360px;max-width:calc(100vw - 40px);height:460px;z-index:2000;background:#fff;border:1px solid #ccc;border-radius:12px;box-shadow:0 10px 30px rgba(0,0,0,.2);flex-direction:column;overflow:hidden;">
    <div style="padding:10px 14px;background:#586369;color:#fff;font-weight:700;display:flex;justify-content:space-between;align-items:center;">
        MHARS Assistant
        <button onclick="document.getElementById('mhars-agent-panel').style.display='none'"
                style="background:none;border:none;color:#fff;font-size:1.2rem;">×</button>
    </div>

    <div id="mhars-agent-messages"
         style="flex:1;overflow:auto;padding:12px;background:#f7f7f7;"></div>

    <div style="display:flex;gap:8px;padding:10px;border-top:1px solid #ddd;background:#fff;">
        <input id="mhars-agent-input"
               class="form-control"
               placeholder="Ask about alerts, shelters, safety..." />
        <button id="mhars-agent-send" class="btn btn-primary">Send</button>
    </div>
</div>

<script>
    const mharsAgentHistory = [];

    function mharsAddMessage(role, text) {
        const box = document.getElementById('mhars-agent-messages');
        const div = document.createElement('div');
        div.style.marginBottom = '10px';
        div.style.textAlign = role === 'user' ? 'right' : 'left';

        const bubble = document.createElement('span');
        bubble.textContent = text;
        bubble.style.display = 'inline-block';
        bubble.style.padding = '8px 11px';
        bubble.style.borderRadius = '10px';
        bubble.style.maxWidth = '85%';
        bubble.style.whiteSpace = 'pre-wrap';
        bubble.style.background = role === 'user' ? '#586369' : '#fff';
        bubble.style.color = role === 'user' ? '#fff' : '#273036';
        bubble.style.border = role === 'user' ? 'none' : '1px solid #ddd';

        div.appendChild(bubble);
        box.appendChild(div);
        box.scrollTop = box.scrollHeight;
    }

    async function mharsSend() {
        const input = document.getElementById('mhars-agent-input');
        const text = input.value.trim();
        if (!text) return;

        input.value = '';
        mharsAddMessage('user', text);
        mharsAgentHistory.push({ role: 'user', content: text });

        const district =
            document.getElementById('districtSelect')?.value || null;

        try {
            const res = await fetch('/api/agent/chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    message: text,
                    district: district,
                    history: mharsAgentHistory.slice(-6)
                })
            });

            const data = await res.json();
            const reply = data.reply || 'No response.';

            mharsAddMessage('assistant', reply);
            mharsAgentHistory.push({ role: 'assistant', content: reply });
        } catch {
            mharsAddMessage(
                'assistant',
                'Assistant unavailable. For emergencies call 999 or 1090.'
            );
        }
    }

    document.getElementById('mhars-agent-button').onclick = () => {
        const p = document.getElementById('mhars-agent-panel');
        p.style.display = p.style.display === 'flex' ? 'none' : 'flex';
    };

    document.getElementById('mhars-agent-send').onclick = mharsSend;

    document.getElementById('mhars-agent-input')
        .addEventListener('keydown', e => {
            if (e.key === 'Enter') mharsSend();
        });
</script>
</head>
<body>
    <!-- Keyboard users can jump past the header. Bootstrap's own utility, no extra CSS. -->
    <a class="visually-hidden-focusable" href="#mainContent">Skip to main content</a>

    <!-- TOP UTILITY BAR -->
    <div class="top-utility-bar">
        <div class="container-xl px-3 d-flex justify-content-between align-items-center">
            <div>
                <span><i class="bi bi-clock me-1"></i> <span id="liveClock">--:--:-- BST (UTC+6)</span></span>
                <span class="ms-3 d-none d-sm-inline"><i class="bi bi-shield-check text-success me-1"></i> FFWC &middot; BMD &middot; USGS Network</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <a href="tel:999" class="text-warning fw-semibold"><i class="bi bi-telephone-fill"></i> 999 Emergency</a>
                <a href="tel:1090" class="d-none d-sm-inline fw-semibold"><i class="bi bi-shield-fill"></i> 1090 Disaster</a>
                <!-- Theme Toggle -->
                <button type="button" class="theme-toggle-pill" onclick="toggleTheme()" aria-label="Switch between light and dark theme">
                    <span id="themePillIcon" aria-hidden="true">🌙</span> <span id="themeLabel">Dark Mode</span>
                </button>
            </div>
        </div>
    </div>

    <!-- MAIN HEADER -->
    <header class="mhars-header">
        <div class="container-xl px-3">
            <div class="row align-items-center g-3">

                <!-- Brand -->
                <div class="col-12 col-md-5">
                    <div>
                        <div class="brand-title">RapidShonket</div>
                        <div class="brand-sub">Multi-Hazard Alert &amp; Response — Bangladesh</div>
                        <div class="brand-tagline">Monitor &middot; Verify &middot; Alert</div>
                        <!-- Header CTA buttons -->
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            <a href="#districtSelectorStrip" class="btn-header-primary">
                                <i class="bi bi-geo-alt-fill"></i> Check My District
                            </a>
                            <a asp-controller="Alerts" asp-action="Index" class="btn-header-secondary">
                                <i class="bi bi-list-ul"></i> View All Alerts
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Mission -->
                <div class="col-12 col-md-4 d-none d-md-block">
                    <div class="mission-text-box">
                        RapidShonket connects <strong>Flood Forecasting &amp; Warning Centre (FFWC)</strong>, <strong>Bangladesh Meteorological Department (BMD)</strong>, and <strong>USGS Earthquake Hazards Program</strong> into one citizen-facing alert system.
                    </div>
                </div>

                <!-- Status badge -->
                <div class="col-12 col-md-3 text-md-end">
                    <span class="badge bg-danger p-2 font-heading fw-bold shadow-sm"><i class="bi bi-exclamation-triangle-fill"></i> National Hazard Watch Active</span>
                </div>

            </div>
        </div>
    </header>

    <!-- DISTRICT SELECTOR STRIP -->
    <div class="district-selector-strip" id="districtSelectorStrip">
        <div class="container-xl px-3">
            <div class="d-flex align-items-center flex-wrap gap-2">
                <label class="strip-label" for="districtStripSelect">
                    <i class="bi bi-geo-alt me-1"></i> <span lang="bn">আপনার জেলা কোনটি?</span>
                </label>
                <select id="districtStripSelect" class="form-select form-select-sm" style="max-width:230px;"
                        onchange="syncDistrictSelects(this.value)">
                    <option value="All">All Bangladesh</option>
                    <option>Bagerhat</option><option>Bandarban</option><option>Barguna</option>
                    <option>Barishal</option><option>Bhola</option><option>Bogura</option>
                    <option>Brahmanbaria</option><option>Chandpur</option><option>Chapai Nawabganj</option>
                    <option>Chattogram</option><option>Chuadanga</option><option>Cox's Bazar</option>
                    <option>Cumilla</option><option>Dhaka</option><option>Dinajpur</option>
                    <option>Faridpur</option><option>Feni</option><option>Gaibandha</option>
                    <option>Gazipur</option><option>Gopalganj</option><option>Habiganj</option>
                    <option>Jamalpur</option><option>Jashore</option><option>Jhalokati</option>
                    <option>Jhenaidah</option><option>Joypurhat</option><option>Khagrachhari</option>
                    <option>Khulna</option><option>Kishoreganj</option><option>Kurigram</option>
                    <option>Kushtia</option><option>Lakshmipur</option><option>Lalmonirhat</option>
                    <option>Madaripur</option><option>Magura</option><option>Manikganj</option>
                    <option>Meherpur</option><option>Moulvibazar</option><option>Munshiganj</option>
                    <option>Mymensingh</option><option>Naogaon</option><option>Narail</option>
                    <option>Narayanganj</option><option>Narsingdi</option><option>Natore</option>
                    <option>Netrokona</option><option>Nilphamari</option><option>Noakhali</option>
                    <option>Pabna</option><option>Panchagarh</option><option>Patuakhali</option>
                    <option>Pirojpur</option><option>Rajbari</option><option>Rajshahi</option>
                    <option>Rangamati</option><option>Rangpur</option><option>Satkhira</option>
                    <option>Shariatpur</option><option>Sherpur</option><option>Sirajganj</option>
                    <option>Sunamganj</option><option>Sylhet</option><option>Tangail</option>
                    <option>Thakurgaon</option>
                </select>
                <button type="button" class="btn-check-district" onclick="checkDistrictFromStrip()">
                    <i class="bi bi-search"></i> Check Now
                </button>
                <span class="ms-auto d-none d-md-inline" style="font-size:0.76rem; color:rgba(255,255,255,0.55);">
                    <i class="bi bi-info-circle me-1"></i>Select your district to see active alerts
                </span>
            </div>
        </div>
    </div>

    <!-- NAVIGATION TABS -->
    <nav class="main-nav navbar navbar-expand-sm navbar-toggleable-sm">
        <div class="scroll-progress" id="scrollProgress" aria-hidden="true"></div>
        <div class="container-xl px-3">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link@(NavActive("Home"))" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-globe-americas me-1"></i> Live Radar</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link@(NavActive("Alerts"))" asp-area="" asp-controller="Alerts" asp-action="Index"><i class="bi bi-water me-1"></i> River Floods</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link@(NavActive("Earthquakes"))" asp-area="" asp-controller="Earthquakes" asp-action="Index" asp-route-scope="bangladesh"><i class="bi bi-activity me-1"></i> Earthquakes</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link@(NavActive("Shelters"))" asp-area="" asp-controller="Shelters" asp-action="Index"><i class="bi bi-house-door-fill me-1"></i> Shelters</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link@(NavActive("Guidelines"))" asp-area="" asp-controller="Guidelines" asp-action="Index"><i class="bi bi-shield-check me-1"></i> Safety Guidance</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link@(NavActive("RiskIndex"))" asp-area="" asp-controller="RiskIndex" asp-action="Index"><i class="bi bi-graph-up-arrow me-1"></i> Risk Index</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link@(NavActive("Donations"))" asp-area="" asp-controller="Donations" asp-action="Index"><i class="bi bi-heart-fill me-1"></i> Relief Fund</a>
                    </li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle@(NavActive("Dashboard"))" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-gear-fill me-1"></i> Admin Portal</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                                <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="LiveActivity"><i class="bi bi-broadcast me-1"></i> Live Activity</a></li>
                                <li><a class="dropdown-item" asp-controller="Alerts" asp-action="Create">Issue Alert</a></li>
                                <li><a class="dropdown-item" asp-controller="Shelters" asp-action="Create">Add Shelter</a></li>
                                <li><a class="dropdown-item" asp-controller="Donations" asp-action="Manage"><i class="bi bi-cash-coin me-1"></i> Donations</a></li>
                            </ul>
                        </li>
                    }
                </ul>
                <div class="d-flex align-items-center gap-2 py-1">
                    <partial name="_LoginPartial" />
                    <button type="button" class="btn btn-sm btn-light fw-bold py-1 px-3 shadow-sm" onclick="toggleDeviceMode()" aria-pressed="false" id="deviceToggleBtn">
                        <i class="bi bi-phone me-1"></i> <span id="deviceBtnText">Mobile Simulator</span>
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <div class="container-xl px-3 mt-2 view-frame-wrapper" id="viewWrapper">

        <!-- PHONE TOP NOTCH (VISIBLE IN MOBILE SIMULATION MODE) -->
        <div class="phone-status-notch">
            <span id="notchClock">09:41</span>
            <div class="d-flex align-items-center gap-2">
                <span role="button" tabindex="0" onclick="toggleTheme()" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();toggleTheme();}" aria-label="Switch theme" style="cursor: pointer;"><i class="bi bi-circle-half"></i></span>
                <i class="bi bi-wifi" aria-hidden="true"></i>
                <i class="bi bi-battery-full" aria-hidden="true"></i>
            </div>
        </div>

        <main role="main" id="mainContent" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="mhars-footer">
        <div class="container-xl px-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-8">
                    <span class="footer-title">RapidShonket Bangladesh</span> — Academic project for CSE 3200, AUST.
                </div>
                <div class="col-md-4 text-md-end">
                    <span class="font-heading">Emergency Hotlines: <strong>999</strong> | <strong>1090</strong> | <strong>333</strong></span>
                    <br class="d-md-none" />
                    <span>Data: BMD/FFWC bulletins &amp; USGS Earthquake Hazards Program</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // ---------- Live clock ----------
        function updateClock() {
            const now = new Date();
            const full = new Intl.DateTimeFormat('en-GB', {
                hour: '2-digit', minute: '2-digit', second: '2-digit',
                hour12: false, timeZone: 'Asia/Dhaka'
            }).format(now);

            const bar = document.getElementById('liveClock');
            if (bar) bar.textContent = full + ' BST (UTC+6)';

            // Keep the phone simulator's notch honest rather than frozen at 09:41.
            const notch = document.getElementById('notchClock');
            if (notch) notch.textContent = full.slice(0, 5);
        }
        updateClock();
        setInterval(updateClock, 1000);

        // ---------- Theme ----------
        // The attribute itself is set in <head> before first paint. This only
        // flips it on click and keeps the pill's icon and label in sync.
        function applyThemeLabels(isDark) {
            const icon = document.getElementById('themePillIcon');
            const label = document.getElementById('themeLabel');
            if (icon) icon.textContent = isDark ? '☀️' : '🌙';
            if (label) label.textContent = isDark ? 'Light Mode' : 'Dark Mode';
        }

        function toggleTheme() {
            const html = document.documentElement;
            const nowDark = html.getAttribute('data-theme') !== 'dark';
            html.setAttribute('data-theme', nowDark ? 'dark' : 'light');
            applyThemeLabels(nowDark);
            try { localStorage.setItem('rs-theme', nowDark ? 'dark' : 'light'); } catch (e) { }
        }

        applyThemeLabels(document.documentElement.getAttribute('data-theme') === 'dark');

        // ---------- Mobile device simulator ----------
        let isMobile = false;
        function toggleDeviceMode() {
            isMobile = !isMobile;
            document.getElementById('viewWrapper').classList.toggle('mobile-mode', isMobile);
            document.getElementById('deviceBtnText').textContent = isMobile ? 'Exit Simulator' : 'Mobile Simulator';
            const btn = document.getElementById('deviceToggleBtn');
            if (btn) btn.setAttribute('aria-pressed', String(isMobile));
        }

        // ---------- District strip ----------
        function syncDistrictSelects(value) {
            const mapSelect = document.getElementById('districtSelect');
            if (mapSelect) mapSelect.value = value;
        }

        function checkDistrictFromStrip() {
            const stripVal = document.getElementById('districtStripSelect').value;
            const mapSelect = document.getElementById('districtSelect');

            if (mapSelect) {
                const match = [...mapSelect.options].find(o => o.value === stripVal);
                if (match) mapSelect.value = stripVal;
                if (typeof onDistrictChange === 'function') onDistrictChange(stripVal);
                mapSelect.scrollIntoView({ behavior: 'smooth', block: 'center' });
            } else {
                // On non-home pages, hand the choice to the home page.
                window.location.href = '/?district=' + encodeURIComponent(stripVal);
            }
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
