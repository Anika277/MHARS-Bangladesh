<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MHARS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- TOP UTILITY BAR -->
    <div class="top-utility-bar">
        <div class="container-xl px-3 d-flex justify-content-between align-items-center">
            <div>
                <span><i class="bi bi-clock me-1"></i> <span id="liveClock">--:--:-- BST (UTC+6)</span></span>
                <span class="ms-3 d-none d-sm-inline"><i class="bi bi-shield-check text-success me-1"></i> FFWC &middot; BMD &middot; USGS Network</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <a href="tel:999" class="text-warning fw-semibold"><i class="bi bi-telephone-fill"></i> 999 Emergency</a>
                <a href="tel:1090" class="d-none d-sm-inline fw-semibold"><i class="bi bi-shield-fill"></i> 1090 Disaster</a>
                <!-- Theme Toggle -->
                <button class="theme-toggle-pill" onclick="toggleTheme()">
                    <span id="themePillIcon">🌙</span> <span id="themeLabel">Dark Mode</span>
                </button>
            </div>
        </div>
    </div>

    <!-- MAIN HEADER (COLOR #859096) -->
    <header class="mhars-header">
        <div class="container-xl px-3">
            <div class="row align-items-center g-3">
                <div class="col-12 col-md-5">
                    <div class="d-flex align-items-center gap-3">
                        <img src="~/images/mhars_logo.png" asp-append-version="true" alt="MHARS logo" style="height: 64px; width: auto; border-radius: 8px;" />
                        <div>
                            <h1 class="brand-title">M H A R S</h1>
                            <div class="brand-sub">Multi-Hazard Alert &amp; Response System — Bangladesh</div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4 d-none d-md-block">
                    <div class="mission-text-box">
                        MHARS is a public disaster warning framework connecting <strong>Flood Forecasting and Warning Centre (FFWC)</strong>, <strong>Bangladesh Meteorological Department (BMD)</strong>, and <strong>USGS Earthquake Hazards Program</strong>.
                    </div>
                </div>
                <div class="col-12 col-md-3 text-md-end">
                    <span class="badge bg-danger p-2 font-heading fw-bold shadow-sm"><i class="bi bi-exclamation-triangle-fill"></i> National Hazard Watch Active</span>
                </div>
            </div>
        </div>
    </header>

    <!-- NAVIGATION TABS -->
    <nav class="main-nav navbar navbar-expand-sm navbar-toggleable-sm">
        <div class="container-xl px-3">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-globe-americas me-1"></i> Live Radar</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Alerts" asp-action="Index"><i class="bi bi-water me-1"></i> River Floods</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Earthquakes" asp-action="Index"><i class="bi bi-activity me-1"></i> Earthquakes</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Shelters" asp-action="Index"><i class="bi bi-house-door-fill me-1"></i> Shelters</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Guidelines" asp-action="Index"><i class="bi bi-shield-check me-1"></i> Safety Guidance</a>
                    </li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown"><i class="bi bi-gear-fill me-1"></i> Admin Portal</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                                <li><a class="dropdown-item" asp-controller="Alerts" asp-action="Create">Issue Alert</a></li>
                                <li><a class="dropdown-item" asp-controller="Shelters" asp-action="Create">Add Shelter</a></li>
                            </ul>
                        </li>
                    }
                </ul>
                <div class="d-flex align-items-center gap-2 py-1">
                    <partial name="_LoginPartial" />
                    <button class="btn btn-sm btn-light fw-bold py-1 px-3 shadow-sm" onclick="toggleDeviceMode()">
                        <i class="bi bi-phone me-1"></i> <span id="deviceBtnText">Mobile App Simulator</span>
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <div class="container-xl px-3 mt-2 view-frame-wrapper" id="viewWrapper">

        <!-- PHONE TOP NOTCH (VISIBLE IN MOBILE SIMULATION MODE) -->
        <div class="phone-status-notch">
            <span>09:41</span>
            <div class="d-flex align-items-center gap-2">
                <span role="button" onclick="toggleTheme()" style="cursor: pointer;"><i class="bi bi-circle-half"></i></span>
                <i class="bi bi-wifi"></i>
                <i class="bi bi-battery-full"></i>
            </div>
        </div>

        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="mhars-footer">
        <div class="container-xl px-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-8">
                    <span class="footer-title">MHARS Bangladesh</span> — Academic project for CSE 3200, AUST.
                </div>
                <div class="col-md-4 text-md-end">
                    <span class="font-heading">Emergency Hotlines: <strong>999</strong> | <strong>1090</strong> | <strong>333</strong></span>
                    <br class="d-md-none" />
                    <span>Data: BMD/FFWC bulletins &amp; USGS Earthquake Hazards Program</span>
                </div>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
