@model MHARS.Web.Models.Shelter
@{
    ViewData["Title"] = "Add Shelter";
}
<div class="page-title"><i class="bi bi-plus-circle me-1"></i> Add Shelter</div>
<p class="page-subtitle">Add a verified emergency shelter to the public directory.</p>

<div class="row"><div class="col-md-6">
<div class="disaster-panel">
<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="District" class="form-label"></label>
        <select asp-for="District" class="form-select" asp-items="ViewBag.DistrictList"></select>
    </div>
    <div class="mb-3">
        <label asp-for="Address" class="form-label"></label>
        <input asp-for="Address" class="form-control" />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Capacity" class="form-label">Capacity (people)</label>
        <input asp-for="Capacity" class="form-control" />
        <span asp-validation-for="Capacity" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ContactNumber" class="form-label"></label>
        <input asp-for="ContactNumber" class="form-control" />
        <span asp-validation-for="ContactNumber" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-brand-action"><i class="bi bi-check2 me-1"></i> Save</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>
</div>
</div></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
