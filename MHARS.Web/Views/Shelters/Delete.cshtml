@model MHARS.Web.Models.Shelter
@{
    ViewData["Title"] = "Delete Shelter";
}
<h2>Delete Shelter</h2>
<h5>Are you sure you want to delete "@Model.Name"?</h5>
<dl class="row">
    <dt class="col-sm-3">District</dt><dd class="col-sm-9">@Model.District</dd>
    <dt class="col-sm-3">Address</dt><dd class="col-sm-9">@Model.Address</dd>
    <dt class="col-sm-3">Capacity</dt><dd class="col-sm-9">@Model.Capacity</dd>
</dl>
<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>
