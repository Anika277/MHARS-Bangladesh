@model List<MHARS.Web.Models.Shelter>
@{
    ViewData["Title"] = "Shelter Directory";
}
<h2>Shelter Directory</h2>
<p class="text-muted">Search verified shelters by district or name.</p>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-4">
        <label class="form-label">Search</label>
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Name or address..." />
    </div>
    <div class="col-auto">
        <label class="form-label">District</label>
        <select name="district" class="form-select" onchange="this.form.submit()">
            <option value="All">All Districts</option>
            @foreach (var d in MHARS.Web.Models.Districts.List)
            {
                if ((string)ViewBag.SelectedDistrict == d)
                {
                    <option value="@d" selected>@d</option>
                }
                else
                {
                    <option value="@d">@d</option>
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Search</button>
        @if (User.IsInRole("Admin"))
        {
            <a class="btn btn-success" asp-action="Create">Add Shelter</a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-warning">No shelters found.</div>
}
else
{
    <table class="table table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr><th>Name</th><th>District</th><th>Address</th><th>Capacity</th><th>Contact</th>@if (User.IsInRole("Admin")) { <th></th> }</tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td class="fw-bold">@s.Name</td>
                    <td>@s.District</td>
                    <td>@s.Address</td>
                    <td>@s.Capacity.ToString("N0") people</td>
                    <td>@(string.IsNullOrEmpty(s.ContactNumber) ? "-" : s.ContactNumber)</td>
                    @if (User.IsInRole("Admin"))
                    {
                        <td>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@s.Id">Edit</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@s.Id">Delete</a>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
