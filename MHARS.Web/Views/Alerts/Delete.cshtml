@model MHARS.Web.Models.Alert
@{
    ViewData["Title"] = "Delete Alert";
}
<div class="page-title"><i class="bi bi-trash3 me-1"></i> Delete Alert</div>
<div class="disaster-panel">
    <h5 class="font-heading">Are you sure you want to delete this alert?</h5>
    <dl class="row mb-0">
        <dt class="col-sm-3">Hazard</dt><dd class="col-sm-9">@Model.HazardType</dd>
        <dt class="col-sm-3">District</dt><dd class="col-sm-9">@Model.District</dd>
        <dt class="col-sm-3">Title</dt><dd class="col-sm-9">@Model.Title</dd>
        <dt class="col-sm-3">Severity</dt><dd class="col-sm-9">@Model.Severity</dd>
    </dl>
</div>
<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger"><i class="bi bi-trash3 me-1"></i> Delete</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>
