@model List<MHARS.Web.Models.Alert>
@{
    ViewData["Title"] = "All Alerts";
}
<h2>All Hazard Alerts</h2>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label">District</label>
        <select name="district" class="form-select" onchange="this.form.submit()">
            <option value="All">All Districts</option>
            @{
                var selected = ViewBag.Districts != null && ViewBag.SelectedDistrict != null ? (string)ViewBag.SelectedDistrict : "All";
            }
            @if (ViewBag.Districts is string[] districts)
            {
                @foreach (var d in districts)
                {
                    if (selected == d)
                    {
                        <option value="@d" selected>@d</option>
                    }
                    else
                    {
                        <option value="@d">@d</option>
                    }
                }
            }
        </select>
    </div>
</form>

<a class="btn btn-primary mb-3" asp-action="Create">Issue New Alert</a>

<table class="table table-hover table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th>Hazard</th><th>District</th><th>Title</th><th>Severity</th><th>Issued (UTC)</th><th>By</th><th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in Model)
        {
            var badge = a.Severity switch
            {
                MHARS.Web.Models.SeverityLevel.High => "danger",
                MHARS.Web.Models.SeverityLevel.Medium => "warning",
                _ => "success"
            };
            <tr>
                <td>@a.HazardType</td>
                <td>@a.District</td>
                <td>@a.Title</td>
                <td><span class="badge text-bg-@badge">@a.Severity</span></td>
                <td>@a.IssuedAt.ToString("dd MMM yyyy hh:mm")</td>
                <td>@a.IssuedBy</td>
                <td>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@a.Id">Edit</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@a.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
