@model List<MHARS.Web.Models.Alert>
@{
    ViewData["Title"] = "All Alerts";
    var selectedDistrict = ViewBag.SelectedDistrict as string ?? "All";
    var selectedHazard = ViewBag.SelectedHazard as MHARS.Web.Models.HazardType?;
}
<div class="page-title" data-reveal>All Hazard Alerts</div>
<p class="page-subtitle">District-wise flood and earthquake alerts issued by the authority.</p>

<div class="disaster-panel" data-reveal>
    <form method="get" class="row g-2 align-items-end">
        <div class="col-auto">
            <label class="form-label">District</label>
            <select name="district" class="form-select" onchange="this.form.submit()">
                <option value="All" selected="@(selectedDistrict == "All")">All Districts</option>
                @if (ViewBag.Districts is string[] districts)
                {
                    @foreach (var d in districts)
                    {
                        <option value="@d" selected="@(selectedDistrict == d)">@d</option>
                    }
                }
            </select>
        </div>
        <div class="col-auto">
            @if (User.IsInRole("Admin"))
            {
                <a class="btn btn-brand-action" asp-action="Create"><i class="bi bi-plus-circle me-1"></i> Issue New Alert</a>
            }
        </div>
    </form>
</div>

<div class="disaster-panel">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Hazard</th><th>District</th><th>Title</th><th>Severity</th><th>Issued (UTC)</th><th>By</th>@if (User.IsInRole("Admin")) { <th></th> }
                </tr>
            </thead>
            <tbody data-reveal-group>
                @foreach (var a in Model)
                {
                    var badge = a.Severity switch
                    {
                        MHARS.Web.Models.SeverityLevel.High => "danger",
                        MHARS.Web.Models.SeverityLevel.Medium => "warning",
                        _ => "success"
                    };
                    <tr>
                        <td>@a.HazardType</td>
                        <td>@a.District</td>
                        <td class="fw-semibold"><a asp-action="Details" asp-route-id="@a.Id">@a.Title</a></td>
                        <td><span class="badge text-bg-@badge font-heading">@a.Severity</span></td>
                        <td>@a.IssuedAt.ToString("dd MMM yyyy hh:mm")</td>
                        <td>@a.IssuedBy</td>

                        @* only admins get edit/delete buttons, everyone else just views *@

                        @if (User.IsInRole("Admin"))
                        {
                            <td class="text-nowrap">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@a.Id">Edit</a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@a.Id">Delete</a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
