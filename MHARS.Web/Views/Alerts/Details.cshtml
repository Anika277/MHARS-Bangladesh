@model MHARS.Web.Models.Alert
@{
    var badge = Model.Severity switch
    {
        MHARS.Web.Models.SeverityLevel.High => "danger",
        MHARS.Web.Models.SeverityLevel.Medium => "warning",
        _ => "success"
    };
    var iconClass = Model.HazardType == MHARS.Web.Models.HazardType.Flood ? "bi-water" : "bi-activity";
    var iconBox = Model.Severity switch
    {
        MHARS.Web.Models.SeverityLevel.High => "red",
        MHARS.Web.Models.SeverityLevel.Medium => "orange",
        _ => "green"
    };
    ViewData["Title"] = Model.Title;
}
<div class="disaster-panel" data-reveal>
    <div class="panel-header">
        <span><i class="bi @iconClass me-1"></i> @Model.Severity Risk — @Model.District (@Model.HazardType)</span>
        <span class="badge text-bg-@badge font-heading">@Model.Severity</span>
    </div>
    <div class="d-flex align-items-start gap-3">
        <div class="event-icon-box @iconBox"><i class="bi @iconClass"></i></div>
        <div>
            <h4 class="font-heading">@Model.Title</h4>
            <p>@Model.Message</p>
            @if (!string.IsNullOrEmpty(Model.SourceReference))
            {
                <p class="text-muted mb-1">Source: @Model.SourceReference</p>
            }
            <div class="event-meta">Issued by @(Model.IssuedBy ?? "Authority") on @Model.IssuedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</div>
        </div>
    </div>
</div>
<a class="btn btn-brand-action" asp-controller="Home" asp-action="Index"><i class="bi bi-arrow-left me-1"></i> Back to Alerts</a>
