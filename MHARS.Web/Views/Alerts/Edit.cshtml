@model MHARS.Web.Models.Alert
@{
    ViewData["Title"] = "Edit Alert";
}
<div class="page-title" data-reveal><i class="bi bi-pencil-square me-1"></i> Edit Alert</div>
<p class="page-subtitle">Update this alert. Changing the source URL triggers re-verification.</p>

<div class="row">
    <div class="col-md-6">
        <div class="disaster-panel" data-reveal data-reveal-delay="0.08">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <div class="mb-3">
                    <label asp-for="HazardType" class="form-label"></label>
                    <select asp-for="HazardType" class="form-select" asp-items="ViewBag.HazardList"></select>
                </div>
                <div class="mb-3">
                    <label asp-for="District" class="form-label"></label>
                    <select asp-for="District" class="form-select" asp-items="ViewBag.DistrictList"></select>
                </div>
                <div class="mb-3">
                    <label asp-for="Severity" class="form-label"></label>
                    <select asp-for="Severity" class="form-select" asp-items="ViewBag.SeverityList"></select>
                </div>
                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Message" class="form-label"></label>
                    <textarea asp-for="Message" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Message" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="SourceReference" class="form-label">Source Reference (e.g., BMD/FFWC bulletin no.)</label>
                    <input asp-for="SourceReference" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="SourceUrl" class="form-label">Government Source URL</label>
                    <input asp-for="SourceUrl" class="form-control"
                           placeholder="https://ffwc.gov.bd/..." />
                    <span asp-validation-for="SourceUrl" class="text-danger"></span>
                    <div class="form-text">
                        Paste the exact URL of the official bulletin. Changing this field triggers re-verification.
                    </div>
                </div>

                @if (Model.VerificationStatus != MHARS.Web.Models.VerificationStatus.Unverified)
                {
                    <div class="mb-3">
                        <label class="form-label">Current verification</label>
                        <div>
                            @if (Model.VerificationStatus == MHARS.Web.Models.VerificationStatus.SourceReachable)
                            {
                                <span class="badge text-bg-success">
                                    <i class="bi bi-patch-check-fill"></i> Government source verified
                                </span>
                            }
                            else
                            {
                                <span class="badge text-bg-danger">
                                    <i class="bi bi-exclamation-triangle-fill"></i> Source could not be verified
                                </span>
                            }
                            <div class="form-text">@Model.VerificationNote</div>
                        </div>
                    </div>
                }

                <button type="submit" class="btn btn-brand-action"><i class="bi bi-save me-1"></i> Save Changes</button>
                <a class="btn btn-secondary" asp-action="Index">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}