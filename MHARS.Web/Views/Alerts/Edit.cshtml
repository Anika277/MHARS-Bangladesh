@model MHARS.Web.Models.Alert
@{
    ViewData["Title"] = "Edit Alert";
}
<div class="page-title"><i class="bi bi-pencil-square me-1"></i> Edit Alert</div>
<p class="page-subtitle">Update the details of an existing hazard alert.</p>

<div class="row">
    <div class="col-md-6">
        <div class="disaster-panel">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <div class="mb-3">
                    <label asp-for="HazardType" class="form-label"></label>
                    <select asp-for="HazardType" class="form-select" asp-items="ViewBag.HazardList"></select>
                </div>
                <div class="mb-3">
                    <label asp-for="District" class="form-label"></label>
                    <select asp-for="District" class="form-select" asp-items="ViewBag.DistrictList"></select>
                </div>
                <div class="mb-3">
                    <label asp-for="Severity" class="form-label"></label>
                    <select asp-for="Severity" class="form-select" asp-items="ViewBag.SeverityList"></select>
                </div>
                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Message" class="form-label"></label>
                    <textarea asp-for="Message" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Message" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="SourceReference" class="form-label">Source Reference</label>
                    <input asp-for="SourceReference" class="form-control" />
                </div>
                <button type="submit" class="btn btn-brand-action"><i class="bi bi-check2 me-1"></i> Save</button>
                <a class="btn btn-secondary" asp-action="Index">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
