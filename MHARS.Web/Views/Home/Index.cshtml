@model List<MHARS.Web.Models.Alert>
@using MHARS.Web.Services
@using MHARS.Web.Models
@using System.Text.Json
@{
    ViewData["Title"] = "RapidShonket — Live Hazard Radar";

    var allAlerts = (List<Alert>)ViewBag.AllAlerts;
    var earthquakes = (List<EarthquakeEvent>)ViewBag.Earthquakes;
    var shelters = (List<Shelter>)ViewBag.Shelters;

    var floodAlerts = allAlerts.Where(a => a.HazardType == HazardType.Flood).Take(3).ToList();

    var mapAlerts = allAlerts
        .Where(a => Districts.Coordinates.ContainsKey(a.District))
        .GroupBy(a => a.District)
        .Select(g => g.First())
        .Select(a => new
        {
            name = a.District,
            lat = Districts.Coordinates[a.District].Lat,
            lng = Districts.Coordinates[a.District].Lng,
            title = a.Title,
            hazard = a.HazardType.ToString(),
            severity = a.Severity.ToString(),
            message = a.Message,
            source = a.SourceReference ?? (a.HazardType == HazardType.Earthquake ? "USGS" : "FFWC/BMD")
        })
        .ToList();

    string SevLabel(SeverityLevel s) => s switch
    {
        SeverityLevel.High => "RED ALERT",
        SeverityLevel.Medium => "ORANGE ALERT",
        _ => "GREEN ALL CLEAR"
    };
    string SevEmoji(SeverityLevel s) => s switch
    {
        SeverityLevel.High => "🔴",
        SeverityLevel.Medium => "🟡",
        _ => "🟢"
    };
}

<!-- BREAKING NEWS TICKER (COLOR #e4e3e3) -->
<div class="news-ticker-bar">
    <div class="container-xl px-3">
        <div class="d-flex align-items-center">
            <span class="news-badge-chevron">Latest Alerts</span>
            <marquee behavior="scroll" direction="left" scrollamount="6" class="fw-semibold">
                @if (allAlerts.Any())
                {
                    @foreach (var a in allAlerts.Take(5))
                    {
                        <text>@SevEmoji(a.Severity) @a.District: @a.Title &nbsp;&nbsp;|&nbsp;&nbsp; </text>
                    }
                }
                else
                {
                    <text>🟢 No active alerts across monitored districts — baseline normal</text>
                }
                <text>🏠 @shelters.Count+ verified shelters open with power &amp; water</text>
            </marquee>
        </div>
    </div>
</div>

<div class="container-xl px-3 mt-2">

    <!-- PROMINENT DISASTER SHOWCASE BANNER -->
    <div class="hero-disaster-banner" data-reveal>
        <div class="row align-items-center g-3">
            <div class="col-12 col-lg-8">
                <span class="badge bg-danger font-heading text-uppercase px-2 py-1 mb-2">
                    <i class="bi bi-exclamation-triangle-fill"></i> Live Inundation Watch
                </span>
                <h2 class="hero-banner-title">Bangladesh River Basin &amp; Seismic Early Warning Portal</h2>
                <p class="hero-banner-desc">
                    Real-time consolidation of river basin surge levels, USGS seismographs, verified multi-purpose shelters, and emergency survival directives.
                </p>
                <div class="d-flex flex-wrap gap-2 small">
                    @if (floodAlerts.Any())
                    {
                        @foreach (var a in floodAlerts.Take(2))
                        {
                            string floodIcon = a.Severity == SeverityLevel.Low ? "bi-shield-check" : "bi-water";
                            <span class="badge bg-dark bg-opacity-75 border border-light-subtle px-3 py-2 fw-medium">
                                <i class="bi @floodIcon text-danger me-1"></i> @a.District: @a.Title
                            </span>
                        }
                    }
                    @if (earthquakes.Any())
                    {
                        var top = earthquakes.OrderByDescending(e => e.Magnitude).First();
                        <span class="badge bg-dark bg-opacity-75 border border-light-subtle px-3 py-2 fw-medium">
                            <i class="bi bi-activity text-warning me-1"></i> Seismic: M @top.Magnitude.ToString("0.0") — @top.SeverityLabel
                        </span>
                    }
                </div>
            </div>
            <div class="col-12 col-lg-4 text-lg-end">
                <div class="p-3 rounded bg-dark bg-opacity-75 border border-light-subtle text-start small">
                    <div class="text-white-50 small mb-1 font-heading fw-semibold"><i class="bi bi-telephone-outbound text-danger me-1"></i> Emergency Operations:</div>
                    <a href="tel:999" class="btn btn-danger btn-sm w-100 fw-bold mb-2 font-heading">
                        <i class="bi bi-telephone-fill"></i> Call 999 National Emergency
                    </a>
                    <a href="tel:1090" class="btn btn-warning btn-sm w-100 fw-bold font-heading text-dark">
                        <i class="bi bi-shield-fill"></i> Call 1090 Disaster Helpline
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- INTERACTIVE GEOSPATIAL MAP -->
    <div class="gis-map-frame" data-reveal data-reveal-delay="0.05">
        <div id="disasterMap"></div>

        <!-- Floating Triage Dropdown Overlay -->
        <div class="map-triage-overlay">
            <label class="form-label small fw-bold mb-1 font-heading"><i class="bi bi-search me-1"></i> District Hazard Triage</label>
            <select id="districtSelect" class="form-select form-select-sm mb-2 font-heading fw-semibold" onchange="onDistrictChange(this.value)">
                <option value="All">All Bangladesh (Overview)</option>
                @foreach (var m in mapAlerts)
                {
                    var emoji = m.severity == "High" ? "🔴" : m.severity == "Medium" ? "🟡" : "🟢";
                    <option value="@m.name">@m.name (@emoji @(m.hazard == "Flood" ? "Flood" : "Quake"))</option>
                }
            </select>

            <div class="d-grid">
                <button class="btn btn-sm btn-outline-secondary font-heading fw-semibold" style="font-size: 0.8rem;" onclick="resetMap()">
                    <i class="bi bi-arrows-fullscreen"></i> Reset National View
                </button>
            </div>
        </div>

        <!-- Map Legend -->
        <div class="p-2 px-3 border-top d-flex flex-wrap justify-content-between align-items-center gap-2 small"
             style="background: #1A2E24; border-radius: 0 0 9px 9px;">
            <div class="d-flex align-items-center gap-3 font-heading fw-semibold">
                <span style="color: rgba(255,255,255,0.55);">Alert Levels:</span>
                <span style="color: #FF6B6B;"><i class="bi bi-circle-fill"></i> Red (Critical)</span>
                <span style="color: #FFB347;"><i class="bi bi-circle-fill"></i> Orange (Moderate)</span>
                <span style="color: #6BCB77;"><i class="bi bi-circle-fill"></i> Green (Clear)</span>
            </div>
            <div class="d-none d-md-flex align-items-center gap-3" style="color: rgba(255,255,255,0.55);">
                <span><i class="bi bi-water" style="color:#60B4FF;"></i> Floods: FFWC</span>
                <span><i class="bi bi-activity" style="color:#FFB347;"></i> Earthquakes: USGS</span>
                <span><i class="bi bi-house-door-fill" style="color:#6BCB77;"></i> Shelters: Verified</span>
            </div>
        </div>
    </div>

    <!-- HOW IT WORKS -->
    <div class="how-it-works">
        <div class="how-it-works-title"><i class="bi bi-info-circle me-2"></i>How RapidShonket Works</div>
        <div class="row g-3 align-items-stretch" data-reveal-group>
            <div class="col-12 col-md-4">
                <div class="step-card">
                    <div class="step-icon"><i class="bi bi-graph-up-arrow"></i></div>
                    <div class="step-label">1. Monitor</div>
                    <div class="step-desc">USGS seismograph data and river gauge readings from FFWC/BMD are continuously pulled into the system in real-time.</div>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="step-card">
                    <div class="step-icon"><i class="bi bi-clipboard2-check"></i></div>
                    <div class="step-label">2. Verify</div>
                    <div class="step-desc">Earthquake data is auto-classified by magnitude. Flood alerts are cross-checked by an Admin against official FFWC/BMD bulletins before publishing.</div>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="step-card">
                    <div class="step-icon"><i class="bi bi-bell-fill"></i></div>
                    <div class="step-label">3. Alert</div>
                    <div class="step-desc">Verified alerts appear instantly on the district map and alert feed — color-coded by severity so citizens can act in seconds.</div>
                </div>
            </div>
        </div>
    </div>

    <!-- MULTI-COLUMN DISASTER MATRIX -->
    <div class="disaster-panel">
        <div class="row g-4">

            <!-- COLUMN 1: EARTHQUAKES (USGS FEED) -->
            <div class="col-12 col-md-6 col-lg-3" data-reveal-group>
                <div class="matrix-col-header">
                    <span><i class="bi bi-activity me-1"></i> Earthquakes (USGS)</span>
                    <span class="badge bg-secondary fw-normal">@earthquakes.Count events</span>
                </div>

                @if (!earthquakes.Any())
                {
                    <div class="event-meta p-2">USGS feed unavailable right now.</div>
                }
                else
                {
                    @foreach (var e in earthquakes)
                    {
                        var box = e.BadgeClass; // success / warning / danger
                        var boxClass = box == "danger" ? "red" : box == "warning" ? "orange" : "green";
                        <a href="@e.Url" target="_blank" rel="noopener" class="event-feed-item">
                            <div class="event-icon-box @boxClass"><i class="bi bi-activity"></i></div>
                            <div>
                                <div class="event-title">@e.Place (M @e.Magnitude.ToString("0.1"))</div>
                                <div class="event-meta">Depth: @e.DepthKm km · @e.TimeUtc.ToLocalTime().ToString("dd MMM HH:mm") BST</div>
                            </div>
                        </a>
                    }
                }
            </div>

            <!-- COLUMN 2: FLOOD INUNDATION (FFWC BULLETINS) -->
            <div class="col-12 col-md-6 col-lg-3" data-reveal-group>
                <div class="matrix-col-header">
                    <span><i class="bi bi-water me-1"></i> River Floods (FFWC)</span>
                    <span class="badge bg-secondary fw-normal">@floodAlerts.Count bulletins</span>
                </div>

                @if (!floodAlerts.Any())
                {
                    <div class="event-meta p-2">No flood bulletins issued.</div>
                }
                else
                {
                    @foreach (var a in floodAlerts)
                    {
                        var boxClass = a.Severity == SeverityLevel.High ? "red" : a.Severity == SeverityLevel.Medium ? "orange" : "green";
                        <div class="event-feed-item" role="button" onclick="focusDistrict('@a.District.Replace("'", @"\'")')">
                            <div class="event-icon-box @boxClass"><i class="bi bi-water"></i></div>
                            <div>
                                <div class="event-title">@a.District — @a.Title</div>
                                <div class="event-meta">@SevLabel(a.Severity) @if (!string.IsNullOrEmpty(a.SourceReference)) { <text>· @a.SourceReference</text> }</div>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- COLUMN 3: VERIFIED SHELTER DIRECTORY -->
            <div class="col-12 col-md-6 col-lg-3" data-reveal-group>
                <div class="matrix-col-header">
                    <span><i class="bi bi-house-door-fill me-1"></i> Shelters Directory</span>
                    <span class="badge bg-secondary fw-normal">@shelters.Count listed</span>
                </div>

                @if (!shelters.Any())
                {
                    <div class="event-meta p-2">No shelters listed yet.</div>
                }
                else
                {
                    @foreach (var s in shelters)
                    {
                        <div class="event-feed-item">
                            <div class="event-icon-box green"><i class="bi bi-building-check"></i></div>
                            <div class="w-100">
                                <div class="event-title">@s.Name</div>
                                <div class="event-meta">Capacity: @s.Capacity.ToString("N0") · @s.District</div>
                                @if (!string.IsNullOrEmpty(s.ContactNumber))
                                {
                                    <a href="tel:@s.ContactNumber" class="btn-brand-action mt-1"><i class="bi bi-telephone-fill"></i> Call @s.ContactNumber</a>
                                }
                            </div>
                        </div>
                    }
                }
                <a asp-controller="Shelters" asp-action="Index" class="btn-brand-action mt-2"><i class="bi bi-arrow-right"></i> View Full Directory</a>
            </div>

            <!-- COLUMN 4: LIFE-SAFETY SURVIVAL GUIDANCE -->
            <div class="col-12 col-md-6 col-lg-3" data-reveal-group>
                <div class="matrix-col-header">
                    <span><i class="bi bi-shield-check me-1"></i> Safety Protocols</span>
                    <span class="badge bg-secondary fw-normal">Do's &amp; Don'ts</span>
                </div>

                <div class="safety-card flood">
                    <div class="safety-card-title"><i class="bi bi-water"></i> Flood Action</div>
                    <ul class="safety-items">
                        <li>Move drinking water &amp; food to higher ground immediately.</li>
                        <li>Disconnect all electrical main switches before water enters.</li>
                        <li>Secure important documents in waterproof containers.</li>
                        <li class="danger">Never wade into moving floodwater — even ankle-deep.</li>
                    </ul>
                </div>

                <div class="safety-card earthquake">
                    <div class="safety-card-title"><i class="bi bi-activity"></i> Earthquake Protocol</div>
                    <ul class="safety-items">
                        <li><strong>Drop, Cover &amp; Hold On</strong> under a solid desk or table.</li>
                        <li>Stay away from windows and exterior walls.</li>
                        <li>Move to open ground only after tremors fully stop.</li>
                        <li class="danger">Never use lifts or stairwells during shaking.</li>
                    </ul>
                </div>
            </div>

        </div>
    </div>

    <!-- ACCESS TIERS -->
    <div class="access-tier-section">
        <div class="row g-3" data-reveal-group>
            <!-- Citizen / Guest -->
            <div class="col-12 col-md-6">
                <div class="access-tier-card">
                    <div class="tier-header tier-citizen">
                        <i class="bi bi-person-fill fs-5"></i> Citizen / Guest Access
                        <span class="badge bg-white text-success ms-auto" style="font-size:0.72rem;">No login required</span>
                    </div>
                    <div class="tier-body">
                        <div class="tier-feature"><i class="bi bi-check-circle-fill"></i> View live district flood &amp; earthquake alerts</div>
                        <div class="tier-feature"><i class="bi bi-check-circle-fill"></i> Browse verified emergency shelter directory</div>
                        <div class="tier-feature"><i class="bi bi-check-circle-fill"></i> Read flood &amp; earthquake safety guidance</div>
                        <div class="tier-feature"><i class="bi bi-check-circle-fill"></i> Check district-level hazard status on the map</div>
                        <div class="tier-feature tier-restricted"><i class="bi bi-lock-fill"></i> Alert management — Admin only</div>
                    </div>
                </div>
            </div>
            <!-- Admin / Authority -->
            <div class="col-12 col-md-6">
                <div class="access-tier-card">
                    <div class="tier-header tier-admin">
                        <i class="bi bi-shield-lock-fill fs-5"></i> Admin / Authority Access
                        <span class="badge bg-warning text-dark ms-auto" style="font-size:0.72rem;">Login required</span>
                    </div>
                    <div class="tier-body">
                        <div class="tier-feature"><i class="bi bi-check-circle-fill"></i> Everything in Citizen access</div>
                        <div class="tier-feature"><i class="bi bi-check-circle-fill"></i> Issue and manage district flood alerts (FFWC/BMD bulletins)</div>
                        <div class="tier-feature"><i class="bi bi-check-circle-fill"></i> Add, edit, and remove emergency shelters</div>
                        <div class="tier-feature"><i class="bi bi-check-circle-fill"></i> View analytics dashboard (alert trends, shelter capacity)</div>
                        <div class="tier-feature"><i class="bi bi-check-circle-fill"></i> USGS earthquake alerts auto-imported (no manual entry)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- DISTRICT DETAIL INTEL CARD -->
    <div class="disaster-panel" id="districtDetailCard" data-reveal>
        <div class="disaster-panel-header">
            <div>
                <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                <span id="detailDistrictTitle">National Overview — Bangladesh Multi-Hazard Network</span>
            </div>
            <span class="badge bg-secondary font-heading fw-bold" id="detailBadge">MONITORING ACTIVE</span>
        </div>

        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-8">
                <p class="mb-2" id="detailMessage">
                    Consolidated real-time disaster alerts across all monitored districts. Click any marker on the map or select a district to view detailed hazard levels and verified emergency shelters.
                </p>
                <div class="small text-muted">
                    Official Authority: Bangladesh Meteorological Department &amp; FFWC @if (!string.IsNullOrEmpty(floodAlerts.FirstOrDefault()?.SourceReference)) { <text>· @floodAlerts.First().SourceReference</text> }
                </div>
            </div>
            <div class="col-12 col-md-4 text-md-end">
                <div class="card-inner-box">
                    <div class="small text-muted mb-1 font-heading fw-semibold">Emergency Operations Call:</div>
                    <a href="tel:999" class="btn btn-danger btn-sm fw-bold w-100 mb-1 font-heading">
                        <i class="bi bi-telephone-fill"></i> 999 National Emergency
                    </a>
                    <a href="tel:1090" class="btn btn-warning btn-sm fw-bold w-100 font-heading text-dark">
                        <i class="bi bi-shield-fill"></i> 1090 Flood Helpline
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        const hazardLocations = @Json.Serialize(mapAlerts);

        const severityColors = { High: '#D9383A', Medium: '#E67E22', Low: '#27AE60' };
        const severityBadge = { High: 'bg-danger', Medium: 'bg-warning text-dark', Low: 'bg-success' };
        const severityText = { High: 'RED ALERT', Medium: 'ORANGE ALERT', Low: 'GREEN ALL CLEAR' };
        const hazardIcon = { Flood: 'bi-water', Earthquake: 'bi-activity' };

        function createHazardIcon(color, iconClass) {
            return L.divIcon({
                className: 'custom-map-pin',
                html: `<div style="background-color: ${color}; color: white; width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 14px; box-shadow: 0 2px 6px rgba(0,0,0,0.4); border: 2px solid white;">
                        <i class="bi ${iconClass}"></i>
                       </div>`,
                iconSize: [28, 28],
                iconAnchor: [14, 14],
                popupAnchor: [0, -14]
            });
        }

        const BANGLADESH_CENTER = [23.6850, 90.3563];
        const BANGLADESH_ZOOM   = 7;

        const map = L.map('disasterMap', { zoomControl: true }).setView(BANGLADESH_CENTER, BANGLADESH_ZOOM);
        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);

        const markers = {};
        hazardLocations.forEach(loc => {
            const color = severityColors[loc.severity] || '#859096';
            const marker = L.marker([loc.lat, loc.lng], {
                icon: createHazardIcon(color, hazardIcon[loc.hazard] || 'bi-exclamation-triangle-fill')
            }).addTo(map);
            marker.bindPopup(`
                <div style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 12px; min-width: 180px;">
                    <strong style="color: #586369; font-size: 13px;">${loc.name} — ${loc.title}</strong><br>
                    <span style="color: ${color}; font-weight: 700;">● ${severityText[loc.severity] || 'ALERT'}</span><br>
                    <p style="margin: 4px 0 6px 0; color: #586369; font-family: 'Inter', sans-serif;">${loc.message}</p>
                    <small style="color: #859096;"><strong>Source:</strong> ${loc.source}</small>
                </div>
            `);
            markers[loc.name] = { marker, data: loc };
        });

        function focusDistrict(districtName) {
            const select = document.getElementById('districtSelect');
            if ([...select.options].some(o => o.value === districtName)) {
                select.value = districtName;
            }
            onDistrictChange(districtName);
        }

        function onDistrictChange(districtName) {
            if (districtName === 'All') {
                resetMap();
                return;
            }

            const item = markers[districtName];
            if (item) {
                map.flyTo([item.data.lat, item.data.lng], 9, { duration: 1.2 });
                item.marker.openPopup();

                document.getElementById('detailDistrictTitle').textContent = `${districtName} District — Hazard Intelligence Profile`;
                const badge = document.getElementById('detailBadge');
                badge.textContent = severityText[item.data.severity] || 'ALERT';
                badge.className = `badge font-heading fw-bold ${severityBadge[item.data.severity] || 'bg-secondary'}`;
                document.getElementById('detailMessage').innerHTML =
                    `<strong>${item.data.title}:</strong> ${item.data.message} <em>(Source: ${item.data.source})</em>`;
            }
        }

        function resetMap() {
            document.getElementById('districtSelect').value = 'All';
            map.flyTo(BANGLADESH_CENTER, BANGLADESH_ZOOM, { duration: 1 });
            document.getElementById('detailDistrictTitle').textContent = 'National Overview — Bangladesh Multi-Hazard Network';
            const badge = document.getElementById('detailBadge');
            badge.textContent = 'MONITORING ACTIVE';
            badge.className = 'badge bg-secondary font-heading fw-bold';
            document.getElementById('detailMessage').textContent =
                'Consolidated real-time disaster alerts across all monitored districts. Click any marker on the map or select a district to view detailed hazard levels and verified emergency shelters.';
        }
    </script>
}
