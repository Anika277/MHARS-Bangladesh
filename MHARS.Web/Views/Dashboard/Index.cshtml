@model dynamic
@{
    ViewData["Title"] = "Admin Dashboard";
}
<div class="page-title" data-reveal><i class="bi bi-speedometer2 me-1"></i> Analytics Dashboard</div>
<p class="page-subtitle">Overview of alerts and shelters managed by the authority.</p>

<div class="row mb-4 g-3" data-reveal-group>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-value" data-countup>@ViewBag.TotalAlerts</div>
            <div class="stat-label">Total Alerts</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card stat-orange">
            <div class="stat-value" data-countup>@ViewBag.FloodCount</div>
            <div class="stat-label">Flood Alerts</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card stat-red">
            <div class="stat-value" data-countup>@ViewBag.QuakeCount</div>
            <div class="stat-label">Earthquake Alerts</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card stat-green">
            <div class="stat-value" data-countup>@ViewBag.ShelterCount</div>
            <div class="stat-label">Shelters</div>
        </div>
    </div>
</div>

<div class="disaster-panel" data-reveal>
    <div class="panel-header"><span><i class="bi bi-bar-chart me-1"></i> Alerts Issued per District</span></div>
    <canvas id="districtChart" height="100"></canvas>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        new Chart(document.getElementById('districtChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(ViewBag.ChartLabels),
                datasets: [{
                    label: 'Alerts issued',
                    data: @Html.Raw(ViewBag.ChartData),
                    backgroundColor: 'rgba(133, 144, 150, 0.8)',
                    borderColor: 'rgba(88, 99, 105, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                animation: { duration: 1200, easing: 'easeOutExpo' },
                scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
            }
        });
    </script>
}
