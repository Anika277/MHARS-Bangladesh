@model dynamic
@{
    ViewData["Title"] = "Admin Dashboard";
}
<div class="page-title" data-reveal><i class="bi bi-speedometer2 me-1"></i> Analytics Dashboard</div>
<p class="page-subtitle">Overview of alerts and shelters managed by the authority.</p>

<div class="row mb-4 g-3" data-reveal-group>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-value" data-countup>@ViewBag.TotalAlerts</div>
            <div class="stat-label">Total Alerts</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card stat-orange">
            <div class="stat-value" data-countup>@ViewBag.FloodCount</div>
            <div class="stat-label">Flood Alerts</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card stat-red">
            <div class="stat-value" data-countup>@ViewBag.QuakeCount</div>
            <div class="stat-label">Earthquake Alerts</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card stat-green">
            <div class="stat-value" data-countup>@ViewBag.ShelterCount</div>
            <div class="stat-label">Shelters</div>
        </div>
    </div>
</div>

<div class="row g-3" data-reveal-group>
    <div class="col-12 col-lg-6">
        <div class="disaster-panel" data-reveal>
            <div class="panel-header"><span><i class="bi bi-bar-chart me-1"></i> Alerts Issued per District</span></div>
            <canvas id="districtChart" height="100"></canvas>
        </div>
    </div>
    <div class="col-12 col-lg-6">
        <div class="disaster-panel" data-reveal>
            <div class="panel-header"><span><i class="bi bi-graph-up me-1"></i> Alerts Over Time (by Month)</span></div>
            <canvas id="monthChart" height="100"></canvas>
        </div>
    </div>
    <div class="col-12">
        <div class="disaster-panel" data-reveal>
            <div class="panel-header"><span><i class="bi bi-pie-chart me-1"></i> Severity Breakdown</span></div>
            <canvas id="severityChart" height="80"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        new Chart(document.getElementById('districtChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(ViewBag.ChartLabels),
                datasets: [{
                    label: 'Alerts issued',
                    data: @Html.Raw(ViewBag.ChartData),
                    backgroundColor: 'rgba(133, 144, 150, 0.8)',
                    borderColor: 'rgba(88, 99, 105, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                animation: { duration: 1200, easing: 'easeOutExpo' },
                scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
            }
        });
                new Chart(document.getElementById('monthChart'), {
            type: 'line',
            data: {
                labels: @Html.Raw(ViewBag.MonthLabels),
                datasets: [{
                    label: 'Alerts issued',
                    data: @Html.Raw(ViewBag.MonthData),
                    borderColor: '#1A6B4A',
                    backgroundColor: 'rgba(26, 107, 74, 0.15)',
                    tension: 0.3,
                    fill: true
                }]
            },
            options: {
                animation: { duration: 1200, easing: 'easeOutExpo' },
                scales: { y: { beginAtZero: true, ticks: { precision: 0 } } },
                plugins: { legend: { display: false } }
            }
        });

        new Chart(document.getElementById('severityChart'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(ViewBag.SeverityLabels),
                datasets: [{
                    data: @Html.Raw(ViewBag.SeverityData),
                    backgroundColor: ['#27AE60', '#E67E22', '#D9383A']
                }]
            },
            options: { animation: { duration: 1200 } }
        });
    </script>
}
