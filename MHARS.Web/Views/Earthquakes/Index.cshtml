@model List<MHARS.Web.Services.EarthquakeEvent>
@{
    ViewData["Title"] = "Live Earthquakes (USGS)";
}
<div class="page-title"><i class="bi bi-activity me-1"></i> Live Earthquake Feed</div>
<p class="page-subtitle">
    Real events from the last 24 hours, fetched live from the
    <a href="https://earthquake.usgs.gov/earthquakes/feed/" target="_blank" rel="noopener">USGS Earthquake Hazards Program</a> public API.
    Auto-colored by magnitude: <span class="badge text-bg-success">&lt; 4.0 Minor</span>
    <span class="badge text-bg-warning">4.0–6.0 Moderate</span> <span class="badge text-bg-danger">&gt; 6.0 Severe</span>
</p>

@if (!Model.Any())
{
    <div class="alert alert-warning"><i class="bi bi-wifi-off me-1"></i> Could not reach the USGS feed right now. Please try again later.</div>
}
else
{
    <div class="disaster-panel">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr><th>Magnitude</th><th>Risk Level</th><th>Location</th><th>Depth</th><th>Time (UTC)</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td><strong class="font-heading">@e.Magnitude.ToString("0.0")</strong></td>
                            <td><span class="badge text-bg-@e.BadgeClass font-heading">@e.SeverityLabel</span></td>
                            <td>@e.Place</td>
                            <td>@e.DepthKm km</td>
                            <td>@e.TimeUtc.ToString("dd MMM yyyy, hh:mm tt")</td>
                            <td><a href="@e.Url" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary">Details</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
