{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=MHARS_Bangladesh;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  
  
  "Usgs": {
    "BaseUrl": "https://earthquake.usgs.gov/fdsnws/event/1/query",
    "SyncIntervalMinutes": 15,
    "LookbackDays": 90,
    "BangladeshMinMagnitude": 2.5,
    "RegionalMinMagnitude": 3.5,
    "AsiaMinMagnitude": 4.5,
    "ManualRefreshCooldownSeconds": 60,
    "UserAgent": "RapidShonket/1.0 (AUST CSE 3200 academic project)",
    "MaxRecordsPerQuery": 2000
  },

  
  "Groq": {
  "BaseUrl": "https://api.groq.com/openai/v1",
  "Model": "llama-3.3-70b-versatile",
  "Temperature": 0.2,
  "MaxTokens": 800
   },
  
  "AllowedHosts": "*"
  
}
