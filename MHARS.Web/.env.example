# Copy this file to .env (same folder) and fill in real values. .env is git-ignored.
# Double underscore (__) = nested config section, e.g. SslCommerz:StoreId.

# SSLCommerz SANDBOX credentials (from the registration email / developer.sslcommerz.com)
SslCommerz__StoreId=your_sandbox_store_id
SslCommerz__StorePassword=your_sandbox_store_password
